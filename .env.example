# Megaplan (source)
MEGAPLAN_HOST=https://yourcompany.megaplan.ru
MEGAPLAN_TOKEN=your_megaplan_bearer_token_here

# Planfix (target)
PLANFIX_HOST=https://yourcompany.planfix.com
PLANFIX_TOKEN=your_planfix_bearer_token_here

# Migration options
DRY_RUN=true          # true = validate only, no writes to Planfix
LOG_LEVEL=INFO        # DEBUG | INFO | WARNING | ERROR

# Rate limiting (seconds between requests)
MEGAPLAN_DELAY=0.5
PLANFIX_DELAY=1.0

# Optional: migrate only active contractors
MEGAPLAN_ONLY_ACTIVE=true
